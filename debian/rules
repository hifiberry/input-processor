#!/usr/bin/make -f

export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_build:
	$(MAKE) ladspa riaa_process

override_dh_auto_install:
	$(MAKE) LADSPA_INSTALL_DIR=$(CURDIR)/debian/hifiberry-input-processor/usr/lib/ladspa \
	        install-ladspa
	# Install the command-line utility
	mkdir -p $(CURDIR)/debian/hifiberry-input-processor/usr/bin
	install -m 755 riaa_process $(CURDIR)/debian/hifiberry-input-processor/usr/bin/
	# Install PipeWire configuration files
	mkdir -p $(CURDIR)/debian/hifiberry-input-processor/etc/pipewire/pipewire.conf.d
	install -m 644 pipewire/90-input-processor.conf $(CURDIR)/debian/hifiberry-input-processor/etc/pipewire/pipewire.conf.d/
	mkdir -p $(CURDIR)/debian/hifiberry-input-processor/etc/xdg/wireplumber/wireplumber.conf.d
	install -m 644 pipewire/99-input-processor-autoconnect.conf $(CURDIR)/debian/hifiberry-input-processor/etc/xdg/wireplumber/wireplumber.conf.d/
	# Install documentation
	mkdir -p $(CURDIR)/debian/hifiberry-input-processor/usr/share/doc/hifiberry-input-processor
	install -m 644 README.md $(CURDIR)/debian/hifiberry-input-processor/usr/share/doc/hifiberry-input-processor/
	install -m 644 TEST-PLUGIN.md $(CURDIR)/debian/hifiberry-input-processor/usr/share/doc/hifiberry-input-processor/
	install -m 644 pipewire/README.md $(CURDIR)/debian/hifiberry-input-processor/usr/share/doc/hifiberry-input-processor/README.pipewire.md

override_dh_auto_clean:
	$(MAKE) clean || true

override_dh_compress:
	dh_compress -X.md
